name = "meting-api-serverless"
main = "src/index.js"
compatibility_date = "2025-11-21"
workers_dev = true
compatibility_flags = ["nodejs_compat"]

# KV 存储绑定 (部署后在 Dashboard 绑定，或取消注释并填入 ID)
# [[kv_namespaces]]
# binding = "METING_KV"
# id = "YOUR_KV_NAMESPACE_ID_HERE"

# QQ音乐定时cookie刷新
[triggers]
crons = ["0 */4 * * *"]

# 环境变量 (可选，建议在 Dashboard 设置)
[vars]
# METING_COOKIE_TENCENT = "YOUR_COOKIE_HERE"
# METING_COOKIE_ALLOW_HOSTS = "example.com,*.example.com"
# 企业微信机器人 Webhook（也可以部署后 POST /admin/webhook 写入 KV）
# METING_ALERT_WEBHOOK = "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx"
# 备用 Cookie，多个用 || 分隔（也可以 POST /admin/cookie/backup 动态添加）
# METING_COOKIE_TENCENT_BACKUPS = "uin=...; qqmusic_key=...||uin=..."
METING_ANONYMOUS_FALLBACK = "1"
METING_FALLBACK_SERVERS = "netease"
METING_FALLBACK_STRICT_ARTIST = "0"

[observability]
enabled = false
head_sampling_rate = 1

[observability.logs]
enabled = true
head_sampling_rate = 1
persist = true
invocation_logs = true

[observability.traces]
enabled = false
persist = true
head_sampling_rate = 1
